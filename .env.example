# ============================================
# WHATSAPP BOT CONFIGURATION
# ============================================

# Super Owner - Nomor dengan akses penuh (hanya 1 nomor)
# Format: 628xxxxxxxxxx (tanpa +, tanpa spasi)
WHATSAPP_SUPER_OWNER=628xxxxxxxxxx

# Co-Owners - Nomor dengan akses owner biasa (bisa lebih dari 1)
# Format: pisahkan dengan koma, tanpa spasi
# Contoh: 6289111111111,6289222222222,6289333333333
WHATSAPP_CO_OWNERS=6289999999999,6289888888888

# Channel ID WhatsApp (format: 120363xxxxxxxxx@newsletter)
# Kosongkan jika tidak menggunakan fitur channel
WHATSAPP_CHANNEL_ID=120363xxxxxxxxx@newsletter

# License Key untuk bot (jika menggunakan sistem lisensi)
WHATSAPP_LICENSE_KEY=OTP-xxxxx

# Nomor WhatsApp bot ini (format: 628xxxxxxxxxx)
WHATSAPP_BOT_NUMBER=628xxxxxxxxxx

# ============================================
# TELEGRAM BOT CONFIGURATION
# ============================================

# Token bot Telegram - Dapatkan dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Owner ID Telegram - Dapatkan dari @userinfobot
TELEGRAM_OWNER_ID=your_telegram_owner_id

# Channel testimoni Telegram (tanpa @)
TELEGRAM_CHANNEL_NAME=your_channel_name

# Link grup Telegram
TELEGRAM_GROUP_LINK=https://t.me/your_group

# ============================================
# AI CHATBOT CONFIGURATION
# ============================================

# AI API Base URL
AI_BASE_URL=https://router.cidz.web.id/v1

# AI API Key
AI_API_KEY=your_api_key_here

# ============================================
# NOTIFICATION POLLING CONFIGURATION
# ============================================

# Backend FastAPI URL (base URL tanpa trailing slash)
BACKEND_API_URL=https://api-samling.naufalrafa.my.id

# Secret Key untuk autentikasi ke Backend API
BACKEND_API_SECRET=samling-secret-bot-key-2026

# Polling Interval dalam milidetik (default: 5000 = 5 detik)
NOTIFICATION_POLLING_INTERVAL=5000

# Max retries untuk notifikasi yang gagal (default: 3)
NOTIFICATION_MAX_RETRIES=3
